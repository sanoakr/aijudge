; サブシステム境界の強制（設計原則 P1 / P2 / P9）。
;
; モジュラーモノリスの境界は規約では守られない。CI で落とす。
; 新しい packages/* や evaluators/* を足したら、必ずここにも登録すること。
; 登録漏れを防ぐため、packages/core/tests/test_boundaries.py が
; ディレクトリと突き合わせている。

[importlinter]
root_packages =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_analytics
    aijudge_evalrunner
    aijudge_reviewconsole
    aijudge_sandbox
    aijudge_observation
    aijudge_submission
    aijudge_persistence
    aijudge_grader
    aijudge_identity
    aijudge_studentweb
    aijudge_feedback
    aijudge_admin
    aijudge_toolchain
    aijudge_skill
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_telemetry
    aijudge_audit
    aijudge_webui
    aijudge_ide
    aijudge_runner
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
include_external_packages = True

[importlinter:contract:core-is-independent]
name = core は他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_core
forbidden_modules =
    aijudge_identity
    aijudge_authoring
    aijudge_webui
    aijudge_submission
    aijudge_grading
    aijudge_skill
    aijudge_analytics
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_observation
    aijudge_persistence
    aijudge_feedback
    aijudge_toolchain
    aijudge_telemetry
    aijudge_audit
    aijudge_ide
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
    aijudge_ext_document_text
    aijudge_ext_image_text

; ゲートウェイは他サブシステムを知らない。採点の語彙にも依存しない
; （依存させると、採点以外から LLM を使うたびに採点が引きずられる）。
[importlinter:contract:gateway-is-standalone]
name = LLM ゲートウェイは他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_llm_gateway
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_analytics
    aijudge_sandbox

; S4 は「隔離してプロセスを動かす」だけの層。採点も科目も知らない。
; 知らせると、評価器を差し替えるたびに隔離の実装が引きずられる。
; 逆にここが独立していれば、CAS 実行やシミュレータ実行も同じ層で動かせる。
[importlinter:contract:sandbox-is-standalone]
name = サンドボックス（S4）は他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_sandbox
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_analytics
    aijudge_llm_gateway

[importlinter:contract:core-has-no-io]
name = core は I/O を持たない（DB・HTTP・LLM・ファイル）
type = forbidden
source_modules =
    aijudge_core
forbidden_modules =
    sqlalchemy
    psycopg
    redis
    httpx
    requests
    boto3
    fastapi
    celery
    openai
    anthropic
ignore_imports =
    aijudge_core.ids -> uuid

[importlinter:contract:subsystems-are-independent]
name = サブシステムどうしは直接 import しない（連携はイベント経由）
type = independence
modules =
    aijudge_authoring
    aijudge_grading
    aijudge_llm_gateway
    aijudge_analytics
    aijudge_submission
    aijudge_identity
    aijudge_skill
    aijudge_ide

; S9 は指標の計算だけを持つ純関数の層。採点の実装を知らないので、
; 採点器を差し替えても測定側は変わらない。
[importlinter:contract:analytics-is-pure]
name = 分析（S9）は採点にも I/O にも依存しない
type = forbidden
source_modules =
    aijudge_analytics
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    sqlalchemy
    httpx
    requests

; 観測レコードの形式。記録は Phase 0、計算は Phase 1（ADR 0007）。
; 記録の形式を測定パッケージに置くと、測定を消したときに採点側の import が
; 壊れる。実際に壊れた（2026-08-28 の削除実験）ので、ここに分けてある。
; 何にも依存しない純粋なスキーマとして保つ。
[importlinter:contract:observation-is-a-bare-schema]
name = 観測レコードは何にも依存しない
type = forbidden
source_modules =
    aijudge_observation
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_evalrunner
    aijudge_reviewconsole

; ADR 0007 のもう半分。**採点側が測定側を import しない。**
; 契約が片方向だけだと、採点側から測定パッケージへの import が通ってしまい、
; 「測定を消しても採点は動く」が成立しなくなる。実際にそうなっていた。
[importlinter:contract:grading-does-not-depend-on-measurement]
name = 採点とレビューは測定に依存しない（測定を消しても動く）
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_reviewconsole
forbidden_modules =
    aijudge_analytics
    aijudge_evalrunner

; ADR 0007 の核心。測定は採点の必須機能ではない。
; 測定側が採点の語彙（core / grading）や実行手段（llm_gateway / sandbox）を
; import しないことを機械で保証する。これが破られた瞬間、「analytics と
; evalrunner を削除しても採点は動く」が成立しなくなる。
;
; 測定が読むのは記録済みの観測レコード（aijudge_analytics.Observation）だけ。
[importlinter:contract:measurement-does-not-depend-on-grading]
name = 測定は採点に依存しない（削除しても採点は動く）
type = forbidden
source_modules =
    aijudge_analytics
    aijudge_evalrunner
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_identity
    aijudge_submission
    aijudge_reviewconsole

; インフラ層。S2 / S3 が定義したプロトコルを実装するので、それらに依存する。
; **逆向きは無い。** サブシステムが保存先の実装を知った瞬間、保存先を
; 差し替えられなくなる（インメモリでテストできなくなり、PostgreSQL が
; 全テストの前提になる）。
[importlinter:contract:subsystems-do-not-know-the-store]
name = サブシステムは保存先の実装に依存しない
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_observation
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_ide
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
forbidden_modules =
    aijudge_persistence
    sqlalchemy

; apps/* は合成の中心（composition root）。複数のサブシステムを束ねてよい
; 唯一の層で、逆にサブシステムから apps を参照してはならない。
[importlinter:contract:subsystems-do-not-depend-on-apps]
name = サブシステムはアプリに依存しない
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_analytics
    aijudge_sandbox
    aijudge_observation
    aijudge_submission
    aijudge_persistence
    aijudge_identity
    aijudge_feedback
    aijudge_toolchain
    aijudge_skill
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_telemetry
    aijudge_audit
    aijudge_webui
    aijudge_ide
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
forbidden_modules =
    aijudge_evalrunner
    aijudge_reviewconsole
    aijudge_grader
    aijudge_studentweb
    aijudge_admin
    aijudge_runner

; 言語の扱い方は何にも依存しない。複数の評価器が共有する知識で、片方に
; 置いて他方が import すると評価器どうしが結合する（観測レコードを独立させた
; のと同じ理由、ADR 0007）。
[importlinter:contract:toolchain-is-a-bare-table]
name = 言語定義は何にも依存しない
type = forbidden
source_modules =
    aijudge_toolchain
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_sandbox
    aijudge_analytics
    aijudge_persistence
    aijudge_eval_code_test_runner

; フィードバック生成は評価器と同じ依存の形に留める。core と S6 だけ。
; 採点エンジンを知らせると、採点が終わるまでフィードバックが作れない設計に
; 引きずられる（実際には確定的な結果だけで先に返せる）。保存先を知らせると
; 単体でテストできなくなる。
[importlinter:contract:feedback-depends-on-core-and-gateway-only]
name = フィードバック生成はコアと LLM ゲートウェイにしか依存しない
type = forbidden
source_modules =
    aijudge_feedback
forbidden_modules =
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_analytics
    aijudge_persistence
    aijudge_sandbox

; ADR 0002 の核心。採点エンジンが個々の評価器を知らないことを機械で保証する。
; これが破られた瞬間、「科目を足してもエンジンは無変更」が成立しなくなる。
[importlinter:contract:engine-does-not-know-evaluators]
name = 採点エンジンは個々の Evaluator を import しない
type = forbidden
source_modules =
    aijudge_grading
forbidden_modules =
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_sandbox
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance

; Evaluator が依存してよいのは core・採点プロトコル・LLM ゲートウェイ・S4 の 4 つ。
; ゲートウェイを許すのは「AI 評価器は LLM を使う」が普遍だから。
; 逆にサブシステムへの依存を許すと、評価器が単体でテストできなくなる。
[importlinter:contract:evaluators-depend-on-core-and-protocol-only]
name = Evaluator はコア・採点プロトコル・LLM ゲートウェイ・サンドボックスにしか依存しない
type = forbidden
source_modules =
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
forbidden_modules =
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_analytics

; S7（スキル推定）は採点の実装を知らない。読むのは GradingCompleted が運ぶ
; KcOutcome だけで、どの評価器がどう判定したかには触れない。これが
; 設計原則 P6「Q-matrix を結節点にする」の実体であり、採点の実装を変えても
; S7 が変わらない理由である。
;
; **この契約が破れた瞬間、S7 を削除しても採点が動くことが成立しなくなる**（P2）。
[importlinter:contract:skill-does-not-depend-on-grading]
name = スキル推定（S7）は採点にも保存先にも依存しない
type = forbidden
source_modules =
    aijudge_skill
forbidden_modules =
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_submission
    aijudge_persistence
    aijudge_analytics
    sqlalchemy

; 運用ログの設定は合成ルート（apps/*）だけの責務（ADR 0016）。
; 各パッケージは標準の `logging.getLogger(__name__)` を使うだけでよく、
; ハンドラと書式を決めるのはプロセスを組み立てる側である。ライブラリ側が
; 決め始めると、同じコードが取り込まれ方によって違う出方をする。
; **実際にそうなっていた** ── `basicConfig` はワーカーと finalize にしか無く、
; web とコンソールでは同じ `logger.warning` が root の lastResort に落ちて
; INFO は捨てられていた。
;
; ここを片方向に保つ副作用として、運用ログは採点の依存にならない。
; ログ基盤の不調で採点が止まってはいけない（P2 の degraded mode）。
[importlinter:contract:only-apps-configure-logging]
name = ログの設定を触るのは合成ルートだけ
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_observation
    aijudge_skill
    aijudge_feedback
    aijudge_toolchain
    aijudge_persistence
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_ide
forbidden_modules =
    aijudge_telemetry

; 運用ログは何も知らない。標準 logging の設定だけを持つ層で、採点の語彙も
; 保存先も科目も知らない。知らせた瞬間、「ログを外しても採点は動く」が
; 成立しなくなる（観測レコードを独立させたのと同じ理由、ADR 0007）。
[importlinter:contract:telemetry-knows-nothing]
name = 運用ログは他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_telemetry
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_observation
    aijudge_persistence
    sqlalchemy
    httpx
    requests

; 監査記録は保存先を知らない（ADR 0016）。実装はインメモリと persistence の
; 2 つあり、同じテストが両方に通る ── ここで保存先を知らせた瞬間、その約束が
; 崩れ、PostgreSQL が全テストの前提になる。
;
; 採点エンジンにも運用ログにも依存しない。監査は「誰が何をしたか」の記録で
; あって、採点の一部ではない。**この向きが破れると、監査を消したときに採点が
; 起動しなくなる**（`aijudge_observation` を分けた ADR 0007 と同じ実例）。
; 運用ログを禁じているのは、監査が journald の都合に引きずられないため ──
; 2 つを繋ぐ（`request_id` を渡す）のは合成ルートの仕事である。
[importlinter:contract:audit-knows-no-store]
name = 監査記録は保存先にも採点にも運用ログにも依存しない
type = forbidden
source_modules =
    aijudge_audit
forbidden_modules =
    aijudge_persistence
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_evalrunner
    aijudge_telemetry
    sqlalchemy
    httpx
    requests

; ブラウザ IDE の試しの実行（ADR 0024）。**コードを動かせるのは runner だけ。**
;
; IDE のパッケージは要求を積んで結果を読むだけで、sandbox を知らない。知らせると、
; web（IDE の受付を import する）がコードを動かせる形に一歩近づく。web には
; Docker の権限を与えない（不変条件 I6）ので、構造の側でも閉じておく。
[importlinter:contract:ide-does-not-run-code]
name = IDE のパッケージはコードを動かさない（sandbox を import しない）
type = forbidden
source_modules =
    aijudge_ide
forbidden_modules =
    aijudge_sandbox

; 学生画面の web は sandbox を import しない（不変条件 I6・ADR 0024 §2）。
; 実行は `run_requests` に行を書くだけで、動かすのは別プロセスの runner である。
; web が直接動かし始めると、試験中の実行の山が web のワーカーを塞ぎ、画面ごと
; 固まる ── しかも web に Docker の権限が要るようになる。
[importlinter:contract:web-does-not-run-code]
name = 学生画面は sandbox を import しない（実行は runner の仕事）
type = forbidden
source_modules =
    aijudge_studentweb
forbidden_modules =
    aijudge_sandbox

; 採点は IDE を知らない（不変条件 I2）。IDE からの提出も `/submit` からの提出も
; 同じ `Submission` で、採点側は出どころを区別できない ── できないことを構造で
; 固定する。区別できると、いずれ「IDE の提出だけ」の分岐が採点に入り込み、
; 試しの実行の結果や行動記録が成績に届く道ができる（設計書 §7）。
[importlinter:contract:grading-does-not-know-ide]
name = 採点と評価器は IDE を import しない（提出の出どころを知らない）
type = forbidden
source_modules =
    aijudge_grading
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_ext_document_text
    aijudge_ext_image_text
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
forbidden_modules =
    aijudge_ide

; **行動記録と印は成績に届かない**（ADR 0023 §4・設計書 §7）。成績を作るのは
; 採点ワーカー（`aijudge_grader`）と、成績の確定（`aijudge_admin.finalization`）
; だけで、どちらも IDE の記録を読めないようにする。印は教員が再生で確かめる
; ための目印であって、判定ではない ── 読めるようになった日に「印が付いたら
; 減点」の道ができる。`grading-does-not-know-ide` は採点エンジンと評価器を、
; ここはその外側の合成ルートを閉じる。
;
; **直接の import を禁じる**（`allow_indirect_imports`）。保存層（persistence）は
; IDE の表も実装するので、成績を作る処理が DB を使う限り間接には届く ── それは
; 表の実装であって、印の計算（`aijudge_ide.flags`）を呼ぶ道ではない。
[importlinter:contract:grades-do-not-read-activity]
name = 成績を作る処理は IDE の記録と印を直接 import しない
type = forbidden
allow_indirect_imports = True
source_modules =
    aijudge_grader
    aijudge_admin.finalization
    aijudge_admin.finalize_cli
forbidden_modules =
    aijudge_ide

; **評価器どうしは互いを知らない**（ADR 0002「他のプラグインを知らない」・#434）。
; 共有したい知識は `aijudge_toolchain` や採点プロトコルに置く（言語の表を
; 独立させたのと同じ理由）。片方が他方を import すると、片方だけを差し替えられない。
[importlinter:contract:evaluators-do-not-know-each-other]
name = 評価器・抽出器は互いを import しない
type = independence
modules =
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_eval_network_test_runner
    aijudge_eval_text_pattern_check
    aijudge_eval_checklist_ai_judge
    aijudge_eval_submission_compliance
    aijudge_ext_document_text
    aijudge_ext_image_text

; **印の計算には、間接にも届かない**（ADR 0023 §4・#434）。上の契約は直接の
; import だけを禁じる（保存層が IDE の表を実装するので、パッケージ全体を
; 間接まで禁じると成り立たない）。印（`aijudge_ide.flags`）は保存層も
; 読まないので、こちらは間接まで閉じられる ── 閉じるために `aijudge_ide` の
; `__init__` は印を再エクスポートしない。
[importlinter:contract:grades-cannot-reach-activity-flags]
name = 成績を作る処理からは、印の計算に間接にも届かない
type = forbidden
source_modules =
    aijudge_grader
    aijudge_admin.finalization
    aijudge_admin.finalize_cli
    aijudge_grading
forbidden_modules =
    aijudge_ide.flags

; **アプリどうしは import しない**（段階的な立て直し・段階 0-2、#438）。
;
; アプリは合成の根（composition root）で、互いを知らない ── 業務の処理を共有したいなら
; packages に置く（`docs/design/staged-refactor.md` §2）。ところが実際には、教員
; コンソールと採点ワーカーが `aijudge_admin`（CLI のアプリ）をライブラリとして使っている。
;
; **いまある依存だけを例外として列挙し、それ以外を禁止する。** これ以上増やさない
; ことを先に固定する。例外は段階 3（`apps/admin` → `packages/course_admin`）で 1 本ずつ
; 消える。使われなくなった例外は `unmatched_ignore_imports_alerting = error` が落とす
; （消し忘れた例外が、新しい依存の抜け道にならないように）。
[importlinter:contract:apps-are-independent]
name = アプリどうしは import しない（例外はいまある依存だけ）
type = independence
modules =
    aijudge_reviewconsole
    aijudge_studentweb
    aijudge_grader
    aijudge_admin
    aijudge_evalrunner
    aijudge_runner
ignore_imports =
    aijudge_grader.cli -> aijudge_admin.justification
    aijudge_reviewconsole.api -> aijudge_admin
    aijudge_reviewconsole.api -> aijudge_admin.groups
    aijudge_reviewconsole.app -> aijudge_admin
    aijudge_reviewconsole.manage -> aijudge_admin
    aijudge_reviewconsole.manage -> aijudge_admin.answer_mode
    aijudge_reviewconsole.manage -> aijudge_admin.bundles
    aijudge_reviewconsole.manage -> aijudge_admin.course_definition
    aijudge_reviewconsole.manage -> aijudge_admin.drafting
    aijudge_reviewconsole.manage -> aijudge_admin.groups
    aijudge_reviewconsole.manage -> aijudge_admin.revision
    aijudge_reviewconsole.manage -> aijudge_admin.roster
    aijudge_reviewconsole.manage -> aijudge_admin.rubric
    aijudge_reviewconsole.manage -> aijudge_admin.syllabus
    aijudge_reviewconsole.manage -> aijudge_admin.task_verifier
    aijudge_reviewconsole.manage -> aijudge_admin.tasks
    aijudge_reviewconsole.manage -> aijudge_admin.test_cases
    aijudge_reviewconsole.overview -> aijudge_admin
unmatched_ignore_imports_alerting = error

; アプリは表の行（`aijudge_persistence.schema`）を直接読まない（段階的な立て直し 1-3）。
; 読むのは保存層のメソッド越し。`CourseRow` から `Course` を手で組み立てていた写しが
; 2 つあり、どちらも遅延の減点・KC・ルーブリックの畳み方を読み落としていた ──
; 列を足した日に、保存層の変換だけが直り、写しは黙って古いまま残る。
[importlinter:contract:apps-do-not-read-tables]
name = アプリは表の定義を直接 import しない（保存層のメソッドを通す）
type = forbidden
source_modules =
    aijudge_reviewconsole
    aijudge_studentweb
    aijudge_grader
    aijudge_admin
    aijudge_evalrunner
    aijudge_runner
forbidden_modules =
    aijudge_persistence.schema
; 保存層を通した間接の到達は当然ある（リポジトリが表を読む）。禁じるのは直接の import。
allow_indirect_imports = True
