; サブシステム境界の強制（設計原則 P1 / P2 / P9）。
;
; モジュラーモノリスの境界は規約では守られない。CI で落とす。
; 新しい packages/* や evaluators/* を足したら、必ずここにも登録すること。
; 登録漏れを防ぐため、packages/core/tests/test_boundaries.py が
; ディレクトリと突き合わせている。

[importlinter]
root_packages =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_eval_code_test_runner
include_external_packages = True

[importlinter:contract:core-is-independent]
name = core は他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_core
forbidden_modules =
    aijudge_identity
    aijudge_authoring
    aijudge_submission
    aijudge_grading
    aijudge_skill
    aijudge_portfolio
    aijudge_analytics
    aijudge_transcription
    aijudge_llm_gateway

[importlinter:contract:core-has-no-io]
name = core は I/O を持たない（DB・HTTP・LLM・ファイル）
type = forbidden
source_modules =
    aijudge_core
forbidden_modules =
    sqlalchemy
    psycopg
    redis
    httpx
    requests
    boto3
    fastapi
    celery
    openai
    anthropic
ignore_imports =
    aijudge_core.ids -> uuid

[importlinter:contract:subsystems-are-independent]
name = サブシステムどうしは直接 import しない（連携はイベント経由）
type = independence
modules =
    aijudge_authoring
    aijudge_grading

; ADR 0002 の核心。採点エンジンが個々の評価器を知らないことを機械で保証する。
; これが破られた瞬間、「科目を足してもエンジンは無変更」が成立しなくなる。
[importlinter:contract:engine-does-not-know-evaluators]
name = 採点エンジンは個々の Evaluator を import しない
type = forbidden
source_modules =
    aijudge_grading
forbidden_modules =
    aijudge_eval_code_test_runner

[importlinter:contract:evaluators-depend-on-core-and-protocol-only]
name = Evaluator はコアと採点プロトコルにしか依存しない
type = forbidden
source_modules =
    aijudge_eval_code_test_runner
forbidden_modules =
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_portfolio
    aijudge_analytics
    aijudge_transcription
    aijudge_llm_gateway
