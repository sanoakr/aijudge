; サブシステム境界の強制（設計原則 P1 / P2 / P9）。
;
; モジュラーモノリスの境界は規約では守られない。CI で落とす。
; 新しい packages/* や evaluators/* を足したら、必ずここにも登録すること。
; 登録漏れを防ぐため、packages/core/tests/test_boundaries.py が
; ディレクトリと突き合わせている。

[importlinter]
root_packages =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_analytics
    aijudge_evalrunner
    aijudge_reviewconsole
    aijudge_sandbox
    aijudge_observation
    aijudge_submission
    aijudge_persistence
    aijudge_grader
    aijudge_identity
    aijudge_studentweb
include_external_packages = True

[importlinter:contract:core-is-independent]
name = core は他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_core
forbidden_modules =
    aijudge_identity
    aijudge_authoring
    aijudge_submission
    aijudge_grading
    aijudge_skill
    aijudge_portfolio
    aijudge_analytics
    aijudge_transcription
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_observation
    aijudge_persistence

; ゲートウェイは他サブシステムを知らない。採点の語彙にも依存しない
; （依存させると、採点以外から LLM を使うたびに採点が引きずられる）。
[importlinter:contract:gateway-is-standalone]
name = LLM ゲートウェイは他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_llm_gateway
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_portfolio
    aijudge_analytics
    aijudge_transcription
    aijudge_sandbox

; S4 は「隔離してプロセスを動かす」だけの層。採点も科目も知らない。
; 知らせると、評価器を差し替えるたびに隔離の実装が引きずられる。
; 逆にここが独立していれば、CAS 実行やシミュレータ実行も同じ層で動かせる。
[importlinter:contract:sandbox-is-standalone]
name = サンドボックス（S4）は他のどのサブシステムにも依存しない
type = forbidden
source_modules =
    aijudge_sandbox
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_portfolio
    aijudge_analytics
    aijudge_transcription
    aijudge_llm_gateway

[importlinter:contract:core-has-no-io]
name = core は I/O を持たない（DB・HTTP・LLM・ファイル）
type = forbidden
source_modules =
    aijudge_core
forbidden_modules =
    sqlalchemy
    psycopg
    redis
    httpx
    requests
    boto3
    fastapi
    celery
    openai
    anthropic
ignore_imports =
    aijudge_core.ids -> uuid

[importlinter:contract:subsystems-are-independent]
name = サブシステムどうしは直接 import しない（連携はイベント経由）
type = independence
modules =
    aijudge_authoring
    aijudge_grading
    aijudge_llm_gateway
    aijudge_analytics
    aijudge_submission
    aijudge_identity

; S9 は指標の計算だけを持つ純関数の層。採点の実装を知らないので、
; 採点器を差し替えても測定側は変わらない。
[importlinter:contract:analytics-is-pure]
name = 分析（S9）は採点にも I/O にも依存しない
type = forbidden
source_modules =
    aijudge_analytics
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    sqlalchemy
    httpx
    requests

; 観測レコードの形式。記録は Phase 0、計算は Phase 1（ADR 0007）。
; 記録の形式を測定パッケージに置くと、測定を消したときに採点側の import が
; 壊れる。実際に壊れた（2026-08-28 の削除実験）ので、ここに分けてある。
; 何にも依存しない純粋なスキーマとして保つ。
[importlinter:contract:observation-is-a-bare-schema]
name = 観測レコードは何にも依存しない
type = forbidden
source_modules =
    aijudge_observation
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_evalrunner
    aijudge_reviewconsole

; ADR 0007 のもう半分。**採点側が測定側を import しない。**
; 契約が片方向だけだと、採点側から測定パッケージへの import が通ってしまい、
; 「測定を消しても採点は動く」が成立しなくなる。実際にそうなっていた。
[importlinter:contract:grading-does-not-depend-on-measurement]
name = 採点とレビューは測定に依存しない（測定を消しても動く）
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_reviewconsole
forbidden_modules =
    aijudge_analytics
    aijudge_evalrunner

; ADR 0007 の核心。測定は採点の必須機能ではない。
; 測定側が採点の語彙（core / grading）や実行手段（llm_gateway / sandbox）を
; import しないことを機械で保証する。これが破られた瞬間、「analytics と
; evalrunner を削除しても採点は動く」が成立しなくなる。
;
; 測定が読むのは記録済みの観測レコード（aijudge_analytics.Observation）だけ。
[importlinter:contract:measurement-does-not-depend-on-grading]
name = 測定は採点に依存しない（削除しても採点は動く）
type = forbidden
source_modules =
    aijudge_analytics
    aijudge_evalrunner
forbidden_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_identity
    aijudge_submission
    aijudge_reviewconsole

; インフラ層。S2 / S3 が定義したプロトコルを実装するので、それらに依存する。
; **逆向きは無い。** サブシステムが保存先の実装を知った瞬間、保存先を
; 差し替えられなくなる（インメモリでテストできなくなり、PostgreSQL が
; 全テストの前提になる）。
[importlinter:contract:subsystems-do-not-know-the-store]
name = サブシステムは保存先の実装に依存しない
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_submission
    aijudge_identity
    aijudge_llm_gateway
    aijudge_sandbox
    aijudge_analytics
    aijudge_observation
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
forbidden_modules =
    aijudge_persistence
    sqlalchemy

; apps/* は合成の中心（composition root）。複数のサブシステムを束ねてよい
; 唯一の層で、逆にサブシステムから apps を参照してはならない。
[importlinter:contract:subsystems-do-not-depend-on-apps]
name = サブシステムはアプリに依存しない
type = forbidden
source_modules =
    aijudge_core
    aijudge_grading
    aijudge_authoring
    aijudge_llm_gateway
    aijudge_analytics
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_sandbox
forbidden_modules =
    aijudge_evalrunner
    aijudge_reviewconsole
    aijudge_grader
    aijudge_studentweb

; ADR 0002 の核心。採点エンジンが個々の評価器を知らないことを機械で保証する。
; これが破られた瞬間、「科目を足してもエンジンは無変更」が成立しなくなる。
[importlinter:contract:engine-does-not-know-evaluators]
name = 採点エンジンは個々の Evaluator を import しない
type = forbidden
source_modules =
    aijudge_grading
forbidden_modules =
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
    aijudge_sandbox

; Evaluator が依存してよいのは core・採点プロトコル・LLM ゲートウェイ・S4 の 4 つ。
; ゲートウェイを許すのは「AI 評価器は LLM を使う」が普遍だから。
; 逆にサブシステムへの依存を許すと、評価器が単体でテストできなくなる。
[importlinter:contract:evaluators-depend-on-core-and-protocol-only]
name = Evaluator はコア・採点プロトコル・LLM ゲートウェイ・サンドボックスにしか依存しない
type = forbidden
source_modules =
    aijudge_eval_code_test_runner
    aijudge_eval_rubric_ai_judge
forbidden_modules =
    aijudge_authoring
    aijudge_identity
    aijudge_submission
    aijudge_skill
    aijudge_portfolio
    aijudge_analytics
    aijudge_transcription
