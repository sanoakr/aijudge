# /srv/aijudge/config/aijudge.env の雛形。
#
# **このファイルの実物は git に入れない。** 機関固有の値・接続情報を持つ。
# systemd の `EnvironmentFile=` が読む。`/srv/aijudge` はデータ側なので、
# ディザスタリカバリのバックアップ対象に含める（§3.8 参照）。

# --- データベース --------------------------------------------------------
AIJUDGE_DATABASE_URL=postgresql+psycopg://aijudge@/aijudge?host=/var/run/postgresql

# --- LLM（学習者データはローカルモデルにしか流さない。P7） ----------------
# 学内の ollama ホストの FQDN。短名は他ホストから解決できないことが多い。
AIJUDGE_LLM_BASE_URL=http://YOUR-OLLAMA-HOST.example.ac.jp:11434
AIJUDGE_LLM_MODEL=gemma4:e4b
# 任意。プライマリが応答しない間だけこちらに切り替える（`FallbackProvider`）。
# 未設定ならフォールバックなし。**学外ホストを指してはならない**（P7）。
# AIJUDGE_LLM_FALLBACK_BASE_URL=http://YOUR-BACKUP-OLLAMA-HOST.example.ac.jp:11434

# --- サンドボックス（ADR 0006） -------------------------------------------
AIJUDGE_SANDBOX=auto
AIJUDGE_SANDBOX_WORKDIR=/srv/aijudge/work

# --- リバースプロキシ越しの Cookie / ホスト検証 ---------------------------
AIJUDGE_SECURE_COOKIES=1
# 学生 UI・教員コンソールとも同じホスト名・同じポート（443）で出す（#103）。
AIJUDGE_ALLOWED_HOSTS=YOUR-HOSTNAME.example.ac.jp
AIJUDGE_LEARNER_URL=https://YOUR-HOSTNAME.example.ac.jp
AIJUDGE_CONSOLE_URL=https://YOUR-HOSTNAME.example.ac.jp/console
# レビューコンソール自身に「自分は /console の下で動いている」と伝える
# （`deploy/nginx/aijudge.conf.template` の `location /console/` と対にする）。
# aijudge-web・worker・finalize 等、他のプロセスはこの変数を無視する。
AIJUDGE_CONSOLE_ROOT_PREFIX=/console

# --- 提出物・観測記録 -----------------------------------------------------
AIJUDGE_ARTIFACT_DIR=/srv/aijudge/artifacts
AIJUDGE_GOLDEN_DIR=/srv/aijudge/observations

# --- Google OAuth2 (OIDC) ログイン（#121・#124） --------------------------
# OIDC 設定（client_id/secret・許可ドメイン）自体はテナント単位で DB に
# 持つ（管理者が /manage/oidc-settings から設定する）。ここに置くのは
# その client_secret を暗号化する鍵だけ。**`Fernet.generate_key()` で
# 生成した値を入れる**（`python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`）。一度設定したら変更しない ──
# 変更すると既存の OIDC 設定が復号できなくなる（設定し直しが必要になる）。
AIJUDGE_OIDC_SECRET_KEY=YOUR-FERNET-KEY-HERE
