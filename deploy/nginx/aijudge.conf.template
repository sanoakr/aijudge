# aiJudge のリバースプロキシ雛形。`bootstrap.sh` が __AIJUDGE_HOSTNAME__ を
# 実際のホスト名に置換してから /etc/nginx/sites-available/ に配置する。
#
# 学生 UI とレビューコンソールを **1 ホスト・1 ポート（443）** で出す
# （#103）。コンソールは `/console` 配下。学生アプリ自身はパス接頭辞を
# 知らずに済む（ルート直下のまま） ── 接頭辞が要るのはコンソール側だけ、
# `AIJUDGE_CONSOLE_ROOT_PREFIX=/console` で `aijudge-review` に伝える
# （`apps/reviewconsole/.../urls.py`。テンプレートの絶対リンクと
# `RedirectResponse` の両方がこれを見て `/console` を足す）。
#
# **`location /console/` の末尾スラッシュに `proxy_pass` 側の URI（`/`）が
# 対になっている。** これで nginx はマッチした `/console/` を剥がしてから
# バックエンドへ渡す（バックエンドは `/courses/1` を受け取り、`/console` の
# 存在を知らない）。バックエンドが生成する側のリンクは
# `AIJUDGE_CONSOLE_ROOT_PREFIX` で `/console` を足すので、ブラウザから見た
# 経路と一致する。
#
# **CSS はこの 2 つの location にそのまま乗る**（#184）。両アプリが
# `/static/` で自分の CSS を配るので、学生 UI は `/static/base.css`、
# コンソールは `/console/static/base.css` ── 後者は上の末尾スラッシュの対に
# よって `/static/base.css` としてバックエンドへ渡る。**ここに追加の
# location は要らない。** URL には版（`?v=`）が付くので、増やすなら
# キャッシュの設定だけでよい。
#
# コンソールを学内限定にしたい場合は、この location に `allow`/`deny` や
# 別の認証を足すこと（ここでは掛けない＝学外にも開く既定）。
#
# 証明書取得（Let's Encrypt 等）は含まない。導入側の既存運用に従う。

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __AIJUDGE_HOSTNAME__;

    ssl_certificate     /etc/letsencrypt/live/__AIJUDGE_HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__AIJUDGE_HOSTNAME__/privkey.pem;
    include conf.d/tls.conf;
    include snippets/security-headers.conf;

    # レポート PDF 等。動画は別経路（AIJUDGE_VIDEO_* 系、docs/RUNNING.md 参照）。
    client_max_body_size 25M;

    # 末尾スラッシュ無しは正規化する（無いと location /console/ にマッチしない）。
    location = /console {
        return 301 /console/;
    }

    location /console/ {
        proxy_pass http://127.0.0.1:8765/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    # 動画の分割アップロード（#119）。**1 分割ぶんだけ通ればよい。**
    #
    # 分割は 8 MiB（`UPLOAD_CHUNK_BYTES`）で、受け側は 32 MiB を超える分割を
    # 断る。ここはその上限に合わせる ── 上の 25M のままだと、分割 1 つが
    # 通らずアップロードが始まらない。**全体の大きさ（数 GB）は関係ない**の
    # が、1 回の PUT で送っていた頃との違いである。
    location ~ ^/(uploads|tasks/[^/]+/(uploads|submit-video)) {
        proxy_pass http://127.0.0.1:8080;
        # **keep-alive を効かせる**（既定は HTTP/1.0）。分割は 3 GB で 384 回
        # 送るので、毎回つなぎ直すと接続の確立だけが積み上がる。
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 64M;
        # **受け取りながら渡す。** 溜めてから渡すと、nginx が分割ぶんを
        # ディスクに書いてからアプリへ送る ── いちばん混んでいる時間に
        # 書き込みが倍になる。1 発送信（`submit-video`）では数 GB になる。
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    # ブラウザ IDE のエディタ（Monaco 0.52.2、約 4.5 MB。`editor.main.js` だけで
    # 3.8 MB）。**nginx が直接配る**（設計書 §5.4）── 試験開始の瞬間に 150 名が
    # 一斉に取りに来るので、uvicorn の 2 ワーカーに配らせない。
    #
    # 版はディレクトリ名に入っている（`monaco-0.52.2/`）ので、長期キャッシュで
    # よい。版を上げたら URL が変わる。`alias` の先は配置先のチェックアウト
    # （`deploy.sh` が `/opt/aijudge` に置く）。
    #
    # **この雛形は `bootstrap.sh` が一度配るだけ**で、`deploy.sh` は更新しない。
    # IDE を main に入れる日に、運用機の設定へ手で足すこと。
    location /static/vendor/ {
        alias /opt/aijudge/packages/webui/src/aijudge_webui/assets/vendor/;
        expires 30d;
        # location に `add_header` を書くと、server の `add_header`（下の
        # security-headers）は引き継がれない。ここでも読み直す。
        include snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
        gzip on;
        gzip_types application/javascript text/css;
        gzip_min_length 1024;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 採点結果は SSE で段階配信される。バッファすると更新が遅れて見える。
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __AIJUDGE_HOSTNAME__;
    location / {
        return 301 https://$host$request_uri;
    }
}
