# `pg_dump -Fc` による論理バックアップ。**デプロイ直前にも呼ばれる**
# （`deploy.sh` がロールバックの保険として実行する）。
[Unit]
Description=aiJudge PostgreSQL dump to /srv/aijudge/backups/db
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=aijudge
Group=aijudge
ExecStart=/usr/local/sbin/aijudge-db-backup.sh
Nice=10
IOSchedulingClass=idle
