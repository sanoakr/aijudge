# 締切を過ぎた成績を確定する。`--once` で 1 回走って終わる（timer が呼ぶ）。
[Unit]
Description=aiJudge finalize (close grades past the deadline)
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=aijudge
Group=aijudge
WorkingDirectory=/opt/aijudge
EnvironmentFile=/srv/aijudge/config/aijudge.env
ExecStart=/opt/aijudge/.venv/bin/aijudge-finalize --once
# journald でこのサービスの行を引くための名札（ADR 0016）。
SyslogIdentifier=aijudge-finalize
NoNewPrivileges=yes
ProtectSystem=strict
# **Docker に触らせない**（#416）。`aijudge` は採点ワーカーのために docker
# グループに入っており、docker.sock への書き込みはホストの root と同じである。
# このプロセスは提出物を動かさない（設計書 I6・ADR 0024）ので要らない ──
# 入れておくと、ここに RCE が 1 つあれば、そのままホストの root になる。
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock
ProtectHome=yes
ReadWritePaths=/srv/aijudge /var/lib/aijudge
PrivateTmp=yes
