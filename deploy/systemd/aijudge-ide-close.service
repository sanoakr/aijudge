# ブラウザ IDE の受付終了時の自動提出（設計書 §9.1）。timer から 1 分ごとに流す。
# 何度走らせても同じ結果になる（提出は内容で重複を畳む）。
#
# timer は `aijudge.target` の `Wants=` で起動する（2026-09-24）。
[Unit]
Description=aiJudge IDE close (submit the latest autosave when a set closes)
# 失敗したらメールで知らせる（#422）。
OnFailure=aijudge-notify@%n.service
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=aijudge
Group=aijudge
WorkingDirectory=/opt/aijudge
EnvironmentFile=/srv/aijudge/config/aijudge.env
ExecStart=/opt/aijudge/.venv/bin/aijudge-ide-close --once
SyslogIdentifier=aijudge-ide-close
NoNewPrivileges=yes
ProtectSystem=strict
# **Docker に触らせない**（#416）。`aijudge` は採点ワーカーのために docker
# グループに入っており、docker.sock への書き込みはホストの root と同じである。
# このプロセスは提出物を動かさない（設計書 I6・ADR 0024）ので要らない ──
# 入れておくと、ここに RCE が 1 つあれば、そのままホストの root になる。
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock
ProtectHome=yes
ReadWritePaths=/srv/aijudge /var/lib/aijudge
PrivateTmp=yes
