# ブラウザ IDE の試しの実行を処理する runner（ADR 0024）。**採点ではない。**
# テンプレートユニットなので `aijudge-runner@1` 〜 `aijudge-runner@8` のように
# 複数本立てる。同時に動かす数はこの本数で決め、プロセスの中に並列性は
# 持たせない（運用機では K = 8 から、上限の目安は 12・設計書 §10.0）。
#
# **まだ `aijudge.target` に入れていない。** 置いただけでは何も起動しない。
# 入れるのは段階 3 の負荷試験で K を決め、main に取り込むと決めたとき
# （`docs/design/online-coding-test.md` §12）。入れる日には
# `aijudge-config-check.sh` の `max_connections` の検査に runner の本数を足す
# （設計書 §10.4）。
#
# sandbox（Docker）を使うので docker.service に依存する。web には Docker の
# 権限を与えない（不変条件 I6）── コードを動かすのは採点ワーカーとここだけ。
[Unit]
Description=aiJudge IDE runner (instance %i)
PartOf=aijudge.target
After=network-online.target postgresql.service docker.service
Wants=postgresql.service

[Service]
Type=simple
User=aijudge
Group=aijudge
WorkingDirectory=/opt/aijudge
EnvironmentFile=/srv/aijudge/config/aijudge.env
ExecStart=/opt/aijudge/.venv/bin/aijudge-runner --name runner%i
# journald でこのサービスの行を引くための名札（ADR 0016）。
SyslogIdentifier=aijudge-runner%i
# sandbox を組み立てられないと起動に失敗する（`aijudge-runner` の docstring）。
# Docker の再起動を待つあいだ、5 秒おきに立ち上げ直す。
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/aijudge /var/lib/aijudge
PrivateTmp=yes

[Install]
WantedBy=aijudge.target
