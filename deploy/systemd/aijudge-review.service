# 教員コンソール。教員数は少なく大きなアップロード経路も無いので --workers は不要。
[Unit]
Description=aiJudge instructor console
PartOf=aijudge.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=aijudge
Group=aijudge
WorkingDirectory=/opt/aijudge
EnvironmentFile=/srv/aijudge/config/aijudge.env
ExecStart=/usr/local/bin/uv run --project /opt/aijudge aijudge-review --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=2

[Install]
WantedBy=aijudge.target
