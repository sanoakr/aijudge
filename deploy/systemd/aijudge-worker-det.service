# 決定的評価だけを処理する速い段階。AI 評価（遅い）とキューを分ける
# （ADR 0011）── 遅い LLM 呼び出しの後ろに、2 秒で終わるテスト実行が
# 並んで待たされない。決定的評価はサンドボックス（Docker）を使うので
# docker.service にも依存する。
[Unit]
Description=aiJudge worker (deterministic phase)
# 失敗したらメールで知らせる（#422）。
OnFailure=aijudge-notify@%n.service
PartOf=aijudge.target
After=network-online.target postgresql.service docker.service
Wants=postgresql.service

[Service]
Type=simple
User=aijudge
Group=aijudge
WorkingDirectory=/opt/aijudge
EnvironmentFile=/srv/aijudge/config/aijudge.env
ExecStart=/opt/aijudge/.venv/bin/aijudge-worker --phase deterministic --name det
# journald でこのサービスの行を引くための名札（ADR 0016）。
SyslogIdentifier=aijudge-worker-det
Restart=on-failure
# 停止の要求（SIGTERM）では採点中のジョブをキューへ戻してから止まる（#424）。
# 戻すのは 1 回の DB 書き込みで済むので、これで足りる。超えたら SIGKILL。
TimeoutStopSec=60
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/aijudge /var/lib/aijudge
PrivateTmp=yes

[Install]
WantedBy=aijudge.target
