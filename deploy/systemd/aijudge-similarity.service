# 受付が閉じた課題の、提出どうしの類似を調べる（#203・ADR 0029）。`--once` で 1 回走って
# 終わる（timer が呼ぶ）。**Dolos を sandbox（Docker）で動かす**ので、確定（finalize）と
# 違って docker.sock を塞がない ── 採点ワーカーと同じ権限で動く。
[Unit]
Description=aiJudge similarity (Dolos on submissions past the close)
# 失敗したらメールで知らせる（#422）。1 課題の失敗は 0 で終わる（次の周回で回し直す）。
OnFailure=aijudge-notify@%n.service
After=network-online.target postgresql.service docker.service
Wants=postgresql.service

[Service]
Type=oneshot
User=aijudge
Group=aijudge
WorkingDirectory=/opt/aijudge
EnvironmentFile=/srv/aijudge/config/aijudge.env
ExecStart=/opt/aijudge/.venv/bin/aijudge-similarity --once
# journald でこのサービスの行を引くための名札（ADR 0016）。
SyslogIdentifier=aijudge-similarity
# 採点と取り合わない。締切の後は空いているが、同時に提出が来ても採点を先に通す。
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# 報告の置き場所（`AIJUDGE_SIMILARITY_DIR`・docs/RUNNING.md）。**無くても起動できるよう
# `-` を付ける** ── 置く前に timer が動くと、unit ごと失敗して毎時知らせが来る。
ReadWritePaths=/srv/aijudge /var/lib/aijudge -/work/aijudge/similarity
PrivateTmp=yes
